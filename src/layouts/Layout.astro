---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "../assets/background.png"

interface Props {
	title: string;
	description: string;
	locale: string;
	alternateLinks?: { href: string; hreflang: string }[];
}

const { title, description, locale, alternateLinks } =
	Astro.props as Props;
---

<!doctype html>
<html lang={locale} class="dark">
	<head>
		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={OGImage}
			enableClientRouter
			ogType="website"
			favicons={[  { rel: "icon", type: "image/png", href: "/icon.png", sizes: "32x32" },]}
			alternateLinks={alternateLinks}
		/>
		<script is:inline>
			(() => {
				// apply the saved theme before paint, and to each page the client router swaps in
				const applySavedTheme = (doc) => {
					const theme = localStorage.getItem("theme");
					if (theme) doc.documentElement.classList.toggle("dark", theme === "dark");
				};
				applySavedTheme(document);
				document.addEventListener("astro:before-swap", (e) => applySavedTheme(e.newDocument));
			})();
		</script>
	</head>
	<body class="*:max-w-2xl *:w-full flex flex-col  items-center w-full font-mono px-5 md:px-0 leading-7 lowercase" >
		<slot />
	</body>
</html>
